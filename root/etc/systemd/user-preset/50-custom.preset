enable distrobox-container@.service trantbox-services trantbox-utils
enable distrobox-service-cliphist@.service trantbox-services
enable distrobox-service-easyeffects@.service trantbox-services
enable distrobox-service-fcitx5-daemon@.service trantbox-services
enable distrobox-service-network-manager-applet@.service trantbox-services
enable fumon.service
enable hyprpolkitagent.service
enable pipewire-pulse.service
enable pipewire.service
enable wireplumber.service
disable *
