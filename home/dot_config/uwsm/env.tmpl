export GBM_BACKEND="nvidia-drm"
export __GLX_VENDOR_LIBRARY_NAME="nvidia"
export LIBVA_DRIVER_NAME="nvidia"
export ELECTRON_OZONE_PLATFORM_HINT="auto"

export PATH="{{ .dotfilesDir }}/bin:$PATH:$HOME/.local/bin"
export XDG_DATA_DIRS="{{ .dotfilesDir }}/share:$XDG_DATA_DIRS"
export XDG_CONFIG_DIRS="$XDG_CONFIG_HOME:$XDG_CONFIG_DIRS"

export QT_QPA_PLATFORMTHEME="gtk3"

export GOPASS_CLIPBOARD_COPY_CMD="{{ .dotfilesDir }}/share/gopass/gopass_clipboard_copy_cmd.sh"
export GOPASS_CLIPBOARD_CLEAR_CMD="{{ .dotfilesDir }}/share/gopass/gopass_clipboard_clear_cmd.sh"

export DBX_SKIP_WORKDIR=1

