# Reference from https://github.com/nix-community/home-manager/blob/release-25.05/modules/services/network-manager-applet.nix
[Unit]
Description=Network Manager applet
After=graphical-session.target
PartOf=graphical-session.target

Requires=distrobox-container@%i.service
PartOf=distrobox-container@%i.service
Conflicts=network-manager-applet.service

[Service]
ExecStart=distrobox enter --no-workdir --no-tty %i -- nm-applet

[Install]
WantedBy=graphical-session.target
